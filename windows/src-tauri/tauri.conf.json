{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tandem",
  "version": "0.1.25",
  "identifier": "nl.markmaaktmedia.tandem",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tandem",
        "url": "index.html",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "panel",
        "title": "Tandem",
        "url": "panel.html",
        "width": 352,
        "height": 540,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Files, clipboard, notifications and music between your phone and this PC",
    "longDescription": "Tandem connects your phone, Mac and PC over your own network: files, clipboard, notifications and music, with nothing in between.",
    "copyright": "AGPL-3.0-only",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Dutch"],
        "displayLanguageSelector": false
      }
    }
  }
}
