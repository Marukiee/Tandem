<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- The connection itself -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Keeps the processor and Wi-Fi awake while the Mac's sound plays, with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Showing the screen or the camera on a Mac: a foreground service of the right type, a question that can show
         itself over the lock screen, and the pill that says it is going on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Every one of these is optional and asked for only when its feature is turned on. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- What lets another device of yours browse the files of this phone. The person turns it on in system settings. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- To list the apps whose notifications can be sent on. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Music and video apps, to list the ones that can show what they play. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <!-- Shizuku, to see whether it is installed. The hotspot works without it. -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".TandemApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tandem">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tandem" android:host="pair" />
            </intent-filter>
            <!-- Android reads the share targets from the launcher activity, not from the
                 activity that receives the share. On the wrong one the sheet never lists the
                 devices by name. -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/share_targets" />
        </activity>

        <!-- Share to Tandem: files, images and text, from any app. -->
        <activity
            android:name=".share.ShareTargetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.Tandem.Sheet">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Share to Quick Share: the same sheet, with only the devices nearby. This phone has no Quick Share of Google. -->
        <activity-alias
            android:name=".share.QuickShareTarget"
            android:targetActivity=".share.ShareTargetActivity"
            android:exported="true"
            android:icon="@drawable/ic_quickshare_target"
            android:label="@string/quickshare_share_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".share.ClipboardSendActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tandem.Sheet" />

        <!-- The camera, the scanner and the gallery, for a computer that asks for a picture. -->
        <activity
            android:name=".capture.CaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tandem.Capture" />

        <!-- The question when a Mac wants to see the screen or the camera, and the one of the system after it. -->
        <activity
            android:name=".live.LiveShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tandem.Sheet" />

        <service
            android:name=".live.LiveShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|camera" />

        <receiver android:name=".live.LiveActionReceiver" android:exported="false" />
        <receiver android:name=".quickshare.QuickShareActionReceiver" android:exported="false" />

        <service
            android:name=".share.ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_clipboard"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".quickshare.QuickShareTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_quickshare"
            android:label="@string/tile_quickshare_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".engine.TandemService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".mirror.MirrorListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- This phone's sound to a computer: the system's capture question and the permission to record audio, then a service. -->
        <activity
            android:name=".live.SoundShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".live.SoundShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Lets a computer that shows this phone's screen click and type on it. Off until the person turns it on. -->
        <service
            android:name=".live.TandemAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/tandem_accessibility" />
        </service>

        <receiver android:name=".engine.ActionReceiver" android:exported="false" />

        <!-- Hotspot for the Mac: the Stop button, the screen-less opener of the system
             hotspot switch, and the door Shizuku uses to hand over its binder. -->
        <receiver android:name=".hotspot.HotspotActionReceiver" android:exported="false" />
        <activity
            android:name=".hotspot.OpenTetherSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- The files of the other devices, in the Files app and in every file picker. Only the system may call it:
             the apps that get to a file do so through a grant it hands out. -->
        <provider
            android:name=".files.TandemDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <receiver android:name=".update.InstallResultReceiver" android:exported="false" />
        <receiver android:name=".engine.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Lets the per-app language survive on Android 12, before the system setting existed. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>
    </application>
</manifest>
