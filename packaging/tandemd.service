# systemd user unit for tandemd on a Linux desktop.
# Install: ~/.config/systemd/user/tandemd.service, then
#   systemctl --user daemon-reload && systemctl --user enable --now tandemd
[Unit]
Description=Tandem, files and clipboard between your own devices
# Discovery and connections need a network, and a daemon that starts without one
# only spends its first retries on nothing.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tandemd run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
