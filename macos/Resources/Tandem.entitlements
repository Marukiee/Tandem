<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Scanning a pairing code with the camera. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Bluetooth Low Energy, to ask the phone for its hotspot. The hardened runtime
         blocks it without this. -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>
    <!-- macOS only shows the name of the Wi-Fi network to apps with Location access. It is
         used to fill in the phone's hotspot during setup, nothing else. -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
</dict>
</plist>
