<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>Tandem</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>@APP_NAME@</string>
    <key>CFBundleDisplayName</key><string>@APP_NAME@</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@BUILD@</string>
    <key>CFBundleLocalizations</key>
    <array><string>en</string><string>nl</string></array>
    <key>LSMinimumSystemVersion</key><string>26.0</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSHumanReadableCopyright</key><string>AGPL-3.0. Mark Maakt Media.</string>
    <key>TandemUpdatePublicKey</key><string>@UPDATE_KEY@</string>

    <key>NSLocalNetworkUsageDescription</key>
    <string>Tandem finds your other devices on your network to send files and share your clipboard.</string>
    <key>NSBonjourServices</key>
    <array><string>_tandem._udp</string></array>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>Tandem opens the files of your phone as a drive, and other apps on this Mac use that drive.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Tandem uses Bluetooth to ask your phone to turn on its hotspot when this Mac has no connection.</string>
    <key>NSLocationUsageDescription</key>
    <string>macOS only tells Tandem the name of your Wi-Fi network if it may see your location. Tandem uses the name to set up your phone's hotspot, and never your position.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>macOS only tells Tandem the name of your Wi-Fi network if it may see your location. Tandem uses the name to set up your phone's hotspot, and never your position.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Tandem presses play, pause and skip in Spotify and Music when you do it from your phone.</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>Tandem sends this Mac's sound to your phone when you choose to use your phone as a speaker.</string>
    <key>NSCameraUsageDescription</key>
    <string>Tandem scans the pairing code shown on another device.</string>

    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>Tandem pairing</string>
            <key>CFBundleURLSchemes</key><array><string>tandem</string></array>
        </dict>
    </array>

    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Send with Tandem</string></dict>
            <key>NSMessage</key><string>sendFiles</string>
            <key>NSPortName</key><string>@APP_NAME@</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Send with Quick Share</string></dict>
            <key>NSMessage</key><string>sendQuickShare</string>
            <key>NSPortName</key><string>@APP_NAME@</string>
            <key>NSSendFileTypes</key><array><string>public.item</string></array>
        </dict>
        <!-- Only offered where the app in front can take a picture, which is what the return types say. -->
        <dict>
            <key>NSMenuItem</key><dict><key>default</key><string>Insert from phone</string></dict>
            <key>NSMessage</key><string>insertFromPhone</string>
            <key>NSPortName</key><string>@APP_NAME@</string>
            <key>NSReturnTypes</key>
            <array><string>public.png</string><string>public.tiff</string><string>com.adobe.pdf</string></array>
        </dict>
    </array>
</dict>
</plist>
