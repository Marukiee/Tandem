#!/usr/bin/env python3
# The resource compiler a Windows target asks for, for a type check on a Mac: the icon and the version of the program are never linked by
# `cargo check`, so an empty file is enough.
import sys

args = sys.argv[1:]
for flag in ("/fo", "-fo"):
    if flag in args:
        open(args[args.index(flag) + 1], "wb").close()
sys.exit(0)
